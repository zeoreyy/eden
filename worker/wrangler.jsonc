{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "eden",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  // Free plan, served at eden.<subdomain>.workers.dev (no custom domain — decision #2).
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; everything else is a static asset (free, no Worker invocation).
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Not a secret. Created with `wrangler kv namespace create eden-programme`.
    { "binding": "PROGRAMME", "id": "eedc8a602b18485984c99b334eb9a6a4" }
  ],
  // 8787 is taken by another local project.
  "dev": { "port": 8799 },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
