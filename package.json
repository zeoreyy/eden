{
  "name": "eden",
  "private": true,
  "type": "module",
  "workspaces": ["packages/shared", "scraper", "web", "worker"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "scrape": "npm run scrape -w scraper --",
    "scrape:dry": "npm run scrape -w scraper -- --dry",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "deploy": "npm run build && npm run deploy -w worker"
  }
}
